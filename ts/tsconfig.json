{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@gklsndr/kolavatar-ts": ["../../kolavatar-ts/src/index.ts"]
    }
  },
  "include": ["./**/*.ts", "../../kolavatar-ts/src/**/*.ts"]
}
